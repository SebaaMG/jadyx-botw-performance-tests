# Opt-in host-code optimization. Does not alter Dynarmic's emitted guest instructions.
option(SERIESX_HOST_LTO "Enable MSVC IPO on the native emulator libraries" OFF)
set(SERIESX_HOST_LTO_TARGETS "common;core;video_core;shader_recompiler;dynarmic;audio_core;hid_core;input_common;frontend_common;network;jadyx"
    CACHE STRING "Native targets optimized together; jadyx must be included")
set(SERIESX_PGO_MODE "OFF" CACHE STRING "Native PGO stage: OFF, TRAIN, USE")
set_property(CACHE SERIESX_PGO_MODE PROPERTY STRINGS OFF TRAIN USE)
set(SERIESX_PGO_DATABASE "${CMAKE_BINARY_DIR}/pgo/jadyx.pgd" CACHE FILEPATH
    "Private native PGO database; generated training data must stay outside Git")

if(NOT SERIESX_PGO_MODE MATCHES "^(OFF|TRAIN|USE)$")
    message(FATAL_ERROR "SERIESX_PGO_MODE must be OFF, TRAIN or USE")
endif()
if(SERIESX_HOST_LTO OR NOT SERIESX_PGO_MODE STREQUAL "OFF")
    if(NOT MSVC OR NOT CMAKE_SYSTEM_NAME STREQUAL "WindowsStore" OR NOT TARGET jadyx)
        message(FATAL_ERROR "SeriesX native optimization requires MSVC and the real UWP target")
    endif()
    include(CheckIPOSupported)
    check_ipo_supported(RESULT _seriesx_ipo OUTPUT _seriesx_ipo_error LANGUAGES CXX)
    if(NOT _seriesx_ipo)
        message(FATAL_ERROR "MSVC IPO is unavailable: ${_seriesx_ipo_error}")
    endif()
    # Keep third-party build systems and assembly libraries in their original configuration.
    if(NOT "jadyx" IN_LIST SERIESX_HOST_LTO_TARGETS)
        message(FATAL_ERROR "SERIESX_HOST_LTO_TARGETS must include the final jadyx UWP target")
    endif()
    foreach(_target IN LISTS SERIESX_HOST_LTO_TARGETS)
        if(TARGET ${_target})
            set_property(TARGET ${_target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
        else()
            message(FATAL_ERROR "Unknown SeriesX IPO target: ${_target}")
        endif()
    endforeach()
    target_link_options(jadyx PRIVATE /LTCG)
    if(NOT SERIESX_PGO_MODE STREQUAL "OFF")
        get_filename_component(_seriesx_pgo_parent "${SERIESX_PGO_DATABASE}" DIRECTORY)
        file(MAKE_DIRECTORY "${_seriesx_pgo_parent}")
        if(SERIESX_PGO_MODE STREQUAL "TRAIN")
            # vcvarsall x64 uwp omits the desktop import-library directory. Microsoft's UWP
            # PGO runtime uses the toolset's x64 pgort.lib/pgort140.dll. Reference only that
            # library, not a desktop LIBPATH that could replace the Store CRT selection.
            set(_seriesx_pgort "$ENV{VCToolsInstallDir}lib/x64/pgort.lib")
            if(NOT EXISTS "${_seriesx_pgort}")
                message(FATAL_ERROR "Matching MSVC x64 pgort.lib is unavailable")
            endif()
            target_link_libraries(jadyx PRIVATE "${_seriesx_pgort}")
            target_link_options(jadyx PRIVATE /NODEFAULTLIB:pgort.lib)
            target_link_options(jadyx PRIVATE "/GENPROFILE:EXACT,PGD=${SERIESX_PGO_DATABASE}")
            message(STATUS "SeriesX PGO TRAIN: package matching x64 pgort140.dll; gameplay training still required")
        else()
            if(NOT EXISTS "${SERIESX_PGO_DATABASE}")
                message(FATAL_ERROR "PGO USE requires the trained private database")
            endif()
            target_link_options(jadyx PRIVATE "/USEPROFILE:PGD=${SERIESX_PGO_DATABASE}")
            message(STATUS "SeriesX PGO USE: ${SERIESX_PGO_DATABASE}")
        endif()
    endif()
endif()
