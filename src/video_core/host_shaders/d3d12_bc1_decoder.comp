// Integer BC1 decoding: same endpoint expansion, division and transparent-black rule as
// Jadyx's CPU BC1 path. No hardware BC interpolation, filtering or sRGB round trip.
#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Blocks { uint words[]; };
layout(rgba8, set = 0, binding = 1) uniform writeonly image2DArray decoded;
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint layers;
    uint input_words;
    uint first_word;
};

uvec3 Expand565(uint value) {
    uint r = (value >> 11u) & 31u;
    uint g = (value >> 5u) & 63u;
    uint b = value & 31u;
    return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u),
                 (b << 3u) | (b >> 2u));
}

void main() {
    uvec3 block = gl_GlobalInvocationID;
    uint blocks_x = (width + 3u) / 4u;
    uint blocks_y = (height + 3u) / 4u;
    if (block.x >= blocks_x || block.y >= blocks_y || block.z >= layers) return;
    uint at = first_word + 2u * ((block.z * blocks_y + block.y) * blocks_x + block.x);
    if (at >= input_words || input_words - at < 2u) return;
    uint endpoints = words[at];
    uint indices = words[at + 1u];
    uint c0 = endpoints & 65535u;
    uint c1 = endpoints >> 16u;
    uvec3 a = Expand565(c0), b = Expand565(c1);
    uvec4 palette[4];
    palette[0] = uvec4(a, 255u);
    palette[1] = uvec4(b, 255u);
    if (c0 > c1) {
        palette[2] = uvec4((2u * a + b) / 3u, 255u);
        palette[3] = uvec4((a + 2u * b) / 3u, 255u);
    } else {
        palette[2] = uvec4((a + b) / 2u, 255u);
        palette[3] = uvec4(0u);
    }
    for (uint y = 0u; y < 4u; ++y) {
        for (uint x = 0u; x < 4u; ++x) {
            uvec2 pixel = block.xy * 4u + uvec2(x, y);
            if (pixel.x < width && pixel.y < height) {
                uint selected = (indices >> (2u * (4u * y + x))) & 3u;
                imageStore(decoded, ivec3(pixel, block.z), vec4(palette[selected]) / 255.0);
            }
        }
    }
}
